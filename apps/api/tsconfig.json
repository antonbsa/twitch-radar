{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "../../tests/api/**/*.ts"]
}
