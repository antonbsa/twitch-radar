{
  "name": "twitch-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twitch-radar-dev",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../infra/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_APP_CACHE",
      "id": "ab13e012ba264799a934310d5948f8e5",
      "preview_id": "76f00c08321d4e0c9254304b71ad0dae"
    }
  ],
  // One cron per scheduled job, dispatched on controller.cron in index.ts
  // (ADR 0036): minutely pending-subscription creation (ADR 0031, the
  // default branch), EventSub reconciliation, Twitch token refresh sweep,
  // and stale follow re-sync.
  "triggers": {
    "crons": ["* * * * *", "*/30 * * * *", "5,35 * * * *", "10 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "TWITCH_EVENTS_QUEUE",
        "queue": "twitch-radar-twitch-events"
      },
      {
        "binding": "NOTIFICATION_JOBS_QUEUE",
        "queue": "twitch-radar-notification-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "twitch-radar-twitch-events",
        "max_batch_size": 10,
        // Notifications are time-sensitive: don't hold events waiting
        // for a fuller batch.
        "max_batch_timeout": 1
      },
      {
        "queue": "twitch-radar-notification-jobs",
        "max_batch_size": 10,
        // Same reasoning as above — a staged notification should reach
        // the device promptly, not wait out a batch window.
        "max_batch_timeout": 1
      }
    ]
  },
  // Named environments don't inherit bindings/vars/triggers from the
  // top-level block above, so everything the Worker needs in production
  // is re-declared here in full (Cloudflare Wrangler environment
  // semantics: only a few keys like `main`/`compatibility_date`/`assets`
  // are inherited).
  "env": {
    "production": {
      // Without this, Wrangler defaults to "<name>-production"
      // (`twitch-radar-api-production`), since it suffixes the
      // top-level `name` with the environment name. Set explicitly to
      // pin the exact *.workers.dev hostname.
      "name": "twitch-radar",
      // Captures console.* output (structured JSON from apps/api/src/logger.ts)
      // in the Cloudflare dashboard's Workers Logs. Full capture (no
      // sampling) until real production volume is observed to justify
      // sampling below 1 — see specs/milestones/0-foundations/
      // issue-19-structured-logging.md.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      // Serves apps/web's production build directly from this Worker (no
      // Cloudflare Pages project) so the PWA and the API share one
      // *.workers.dev origin with no custom domain — required by the
      // session cookie having no Domain attribute and there being no CORS
      // handling (see apps/api/src/services/session.ts). Scoped to this
      // environment only (not top-level) - `wrangler dev` (default/dev
      // env, used by local dev and the E2E test tier) never builds
      // apps/web, so a top-level `assets` block made it fail outright
      // with "the directory ... does not exist"; dev serves the SPA via
      // Vite instead, it doesn't need this at all.
      //
      // Without `run_worker_first`, Cloudflare's static-assets layer
      // checks for a matching file *before* invoking the Worker; "/api/*"
      // paths never match a built file, so
      // `not_found_handling: "single-page-application"` was serving the
      // SPA's index.html for them instead of running the Worker's fetch
      // handler at all (e.g. `/api/auth/twitch/start` silently never
      // reached `handleAuthStart`). `run_worker_first` forces "/api/*" to
      // always go to the Worker; every other path still falls through to
      // the static assets, with the SPA index.html as the not-found
      // fallback.
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_URL": "https://twitch-radar.antonbsa.workers.dev",
        // Twitch app's client ID — same app as dev works fine (Twitch
        // allows multiple redirect URIs per client), confirm this
        // matches the app that has the production redirect URI added.
        "TWITCH_CLIENT_ID": "2rhxfgk2zy59lgplzfjoovkdx1r2pq",
        // Public half of a fresh production VAPID keypair — generate
        // with `npm run vapid`, do not reuse the dev keypair. Fill in
        // alongside pushing VAPID_PRIVATE_KEY as a secret (below).
        "VAPID_PUBLIC_KEY": "BEpVIJaZy_euAJ1g4rdM67HkG-ge-uSlnd9sD9dhAOpiEkTYJXE_5Ac3NYCXfKKxZDp8Az1KXqIuZJP-MzhNlEY",
        "VAPID_SUBJECT": "mailto:antonbsa.dev@gmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "twitch-radar-prod",
          "database_id": "92f19382-7232-4183-a123-ec842bb8843c",
          "migrations_dir": "../../infra/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV_APP_CACHE",
          // Filled in by `wrangler kv namespace create KV_APP_CACHE --env production`.
          "id": "7ee708aa02514ba181737f5123ed5407"
        }
      ],
      "triggers": {
        "crons": ["* * * * *", "*/30 * * * *", "5,35 * * * *", "10 * * * *"]
      },
      "queues": {
        "producers": [
          {
            "binding": "TWITCH_EVENTS_QUEUE",
            "queue": "twitch-radar-twitch-events"
          },
          {
            "binding": "NOTIFICATION_JOBS_QUEUE",
            "queue": "twitch-radar-notification-jobs"
          }
        ],
        "consumers": [
          {
            "queue": "twitch-radar-twitch-events",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          },
          {
            "queue": "twitch-radar-notification-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          }
        ]
      }
    },
    // Same shape as production - separate D1/KV/queues (queue names are
    // account-global, so they can't share production's) and its own
    // secrets, so it exercises the real deploy path (including EventSub
    // webhooks) without touching production data or users.
    // `mock-eventsub` only disables itself when ENVIRONMENT ===
    // "production", so it also works here for testing the full
    // notification pipeline without a real Twitch event.
    "preview": {
      "name": "twitch-radar-preview",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "ENVIRONMENT": "preview",
        // Fill in after the first `wrangler deploy --env preview` -
        // Wrangler prints the resulting workers.dev URL.
        "PUBLIC_URL": "https://twitch-radar-preview.antonbsa.workers.dev",
        // Same Twitch app as production - add this environment's
        // PUBLIC_URL callback as an additional redirect URI in the
        // Twitch Developer Console (Twitch allows multiple per app).
        "TWITCH_CLIENT_ID": "2rhxfgk2zy59lgplzfjoovkdx1r2pq",
        "VAPID_PUBLIC_KEY": "BIDjVv9wJgaJ6-GTxIrnbE_zkbOT2uzCc7TrVkevCP0XVqC8DGMd2I1IxBKPwllX5EtiK0KVLOXWhzVybY0_DaQ",
        "VAPID_SUBJECT": "mailto:antonbsa.dev@gmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "twitch-radar-preview",
          "database_id": "cf06d56e-fad0-419f-bef3-4705e59310a9",
          "migrations_dir": "../../infra/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV_APP_CACHE",
          "id": "f3f65972f7404e23ade4a303d9b8371a"
        }
      ],
      // Cron Triggers are capped account-wide (Cloudflare API error 10072:
      // "exceeded the limit of 5 cron triggers"), not per Worker. Production
      // already registers all 4 crons above, leaving only 1 free — so preview
      // gets just the default minutely job (pending EventSub subscription
      // creation, ADR 0031) and no scheduled reconcile/token-refresh/
      // stale-follow-sync in this environment. Those can still be exercised
      // manually in preview via `wrangler deploy --env preview` +
      // `/__scheduled?cron=...` against the running dev/preview worker if
      // needed.
      "triggers": {
        "crons": ["* * * * *"]
      },
      "queues": {
        "producers": [
          {
            "binding": "TWITCH_EVENTS_QUEUE",
            "queue": "twitch-radar-twitch-events-preview"
          },
          {
            "binding": "NOTIFICATION_JOBS_QUEUE",
            "queue": "twitch-radar-notification-jobs-preview"
          }
        ],
        "consumers": [
          {
            "queue": "twitch-radar-twitch-events-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          },
          {
            "queue": "twitch-radar-notification-jobs-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 1
          }
        ]
      }
    }
  }
}
