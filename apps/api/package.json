{
  "name": "@twitch-radar/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9229 --env-file ../../.env.development --env-file ../../.env.local",
    "migrations:create": "drizzle-kit generate --config drizzle.config.ts --prefix index",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:setup": "wrangler d1 migrations apply twitch-radar-dev --local",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. tests/api",
    "vapid": "web-push generate-vapid-keys",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.7",
    "nanoid": "^5.1.15",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260621.1",
    "@types/node": "^26.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
