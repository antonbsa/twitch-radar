{
  "name": "twitch-radar",
  "version": "1.0.0",
  "description": "Mobile-first Twitch category alert PWA.",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "wrangler dev --config apps/api/wrangler.toml --port 8787",
    "dev:web": "wrangler pages dev apps/web --port 8788",
    "db:setup": "wrangler d1 migrations apply twitch-radar-dev --local --config apps/api/wrangler.toml",
    "build": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "vapid": "web-push generate-vapid-keys"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "nanoid": "^5.1.15",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260621.1",
    "@types/node": "^26.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
