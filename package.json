{
  "name": "twitch-radar",
  "version": "1.0.0",
  "description": "Mobile-first Twitch category alert PWA.",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @twitch-radar/api",
    "dev:web": "npm run dev -w @twitch-radar/web",
    "db:setup": "npm run db:setup -w @twitch-radar/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrations:create": "npm --workspace @twitch-radar/api run migrations:create --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "concurrently -n api,web -c blue,green \"npm run test:api\" \"npm run test:web\"",
    "test:api": "npm run test:api:migrate && concurrently -k -n mock,worker,tests -c yellow,blue,magenta -s command-tests \"npm run test:api:mock\" \"npm run test:api:worker\" \"wait-on http://127.0.0.1:8799/health http://127.0.0.1:8788/health && vitest run\"",
    "test:api:migrate": "rm -rf .wrangler/state/test && wrangler d1 migrations apply twitch-radar-dev --local --config apps/api/wrangler.jsonc --persist-to .wrangler/state/test",
    "test:api:mock": "node tests/api/setup/mock-twitch-server.ts",
    "test:api:worker": "wrangler dev --config apps/api/wrangler.jsonc --port 8788 --persist-to .wrangler/state/test --env-file .env.development --env-file .env.local --var TWITCH_AUTH_BASE_URL:http://127.0.0.1:8799 --var TWITCH_API_BASE_URL:http://127.0.0.1:8799",
    "test:web": "vitest run --config vitest.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts tests/web/e2e",
    "vapid": "npm run vapid -w @twitch-radar/api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "eslint": "^8.57.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "wait-on": "^9.0.10"
  }
}
