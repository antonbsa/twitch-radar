{
  "name": "twitch-radar",
  "version": "1.0.0",
  "description": "Mobile-first Twitch category alert PWA.",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @twitch-radar/api",
    "dev:web": "npm run dev -w @twitch-radar/web",
    "db:setup": "npm run db:setup -w @twitch-radar/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "concurrently -n api,web -c blue,green \"npm run test:api\" \"npm run test:web\"",
    "test:api": "vitest run",
    "test:web": "vitest run --config vitest.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts tests/web/e2e",
    "migrations:create": "npm --workspace @twitch-radar/api run migrations:create --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mock-eventsub": "node infra/scripts/dev/mock-eventsub.mjs",
    "dev:mobile": "node infra/scripts/dev/dev-mobile.mjs",
    "vapid": "npm run vapid -w @twitch-radar/api",
    "deploy": "npm run build -w @twitch-radar/web && npm run deploy -w @twitch-radar/api",
    "deploy:preview": "npm run build -w @twitch-radar/web && npm run deploy:preview -w @twitch-radar/api",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "qrcode-terminal": "^0.12.0"
  }
}
