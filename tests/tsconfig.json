{
  "extends": "../apps/api/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals",
      "vite/client",
      "../apps/api/node_modules/@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": ["../apps/web/src/*"]
    }
  },
  "include": [
    "../apps/api/src/globals.d.ts",
    "api/**/*.ts",
    "shared/**/*.ts",
    "contracts/**/*.ts"
  ]
}
