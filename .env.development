PUBLIC_URL=http://localhost:5173
TWITCH_CLIENT_ID=5hq77exwl4m81z2zn85gzcpl1md37e
TOKEN_ENCRYPTION_KEY=dev-encryption-placeholder
VAPID_SUBJECT=mailto:dev@example.com
EVENTSUB_WEBHOOK_SECRET=dev-webhook-placeholder

# Dev server ports — override per worktree in its own .env.local to run several
# `npm run dev` at once. PUBLIC_URL above is re-derived from WEB_DEV_PORT by
# infra/scripts/dev/load-env.mjs unless a .env.local sets PUBLIC_URL itself.
API_DEV_PORT=8787
API_INSPECTOR_PORT=9229
WEB_DEV_PORT=5173

# must be overwritten with actual values ​​for it to work correctly
TWITCH_CLIENT_SECRET=secret-placeholder
VAPID_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
VAPID_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
